---
import Layout from '@/layouts/Base.astro';
import '@/styles/candidates.css';
---
<Layout title="候选资料" pageClass="candidates-page">
  <header class="selection-heading">
    <div><h1>候选资料</h1><p>高级开发者的 AI 实践、工作流与方法。</p></div>
    <a href="/inbox" class="inbox-link">从 RSS 发现文章 ↗</a>
  </header>
  <nav class="workspace-tabs" aria-label="资料审核"><a href="/candidates" aria-current="page">候选资料</a><a href="/evaluations">固定资料评测</a></nav>
  <section class="candidate-ui">
    <p id="message" role="status" aria-live="polite"></p><p id="error" role="alert"></p>
    <details id="intake" class="intake-panel">
      <summary><span aria-hidden="true">＋</span> 添加文章链接</summary>
      <form id="candidate-form">
        <p class="subtle">保存全文不调用模型。中文阅读建议由你按需生成。</p>
        <div class="intake-row"><div><label for="candidate-url">原文链接</label><input id="candidate-url" type="url" required placeholder="https://…"/></div><button class="primary" id="import-button" type="submit">保存原文</button></div>
        <details class="intake-options"><summary>学习目标与来源设置</summary>
          <label for="goal">学习目标</label><textarea id="goal" required maxlength="1500">学习高级开发者在真实项目中使用 AI 的工作流、提示词、Skills 与上下文管理，关注原文依据、适用条件和结果。</textarea>
          <label for="origin">来源类型</label><select id="origin"><option value="user_link">本人提供</option><option value="agent_supplied">Agent 提供</option><option value="rss">RSS 订阅</option><option value="web_search">网页搜索</option><option value="demo">演示材料</option></select>
          <label for="source-note">来源说明</label><input id="source-note" maxlength="1500" placeholder="作者、发现渠道（可选）"/>
          <div class="filter-fields"><div><label for="as-of">判断基准日期（UTC）</label><input id="as-of" type="date" required/></div><div><label for="days">日期窗口（天）</label><input id="days" type="number" value="90" min="1" max="366" required/></div></div>
          <p class="subtle">日期窗口只用于筛选，不代表文章当前有效。</p>
        </details>
      </form>
    </details>
    <div class="candidate-layout">
      <aside class="candidate-rail">
        <details id="queue" open>
          <summary class="queue-heading"><span>文章列表</span><span id="queue-count" role="status">读取中</span></summary>
          <div class="queue-tools">
            <label class="visually-hidden" for="candidate-search">搜索资料</label><input id="candidate-search" type="search" placeholder="搜索标题或来源" autocomplete="off"/>
            <div class="queue-filters" role="group" aria-label="采集状态"><button data-filter="all" aria-pressed="true">全部</button><button data-filter="saved" aria-pressed="false">已保存</button><button data-filter="unscreened" aria-pressed="false">未判断</button><button data-filter="failed" aria-pressed="false">失败</button></div>
            <details id="advanced-filters"><summary>日期与来源筛选</summary>
              <div class="filter-fields"><div><label for="filter-date">发布日期</label><select id="filter-date"><option value="all">全部日期</option><option value="within_window">窗口内</option><option value="outside_window">窗口外</option><option value="unknown_date">日期未知</option><option value="future_date">未来日期</option></select></div><div><label for="filter-origin">资料来源</label><select id="filter-origin"><option value="all">全部来源</option><option value="user_link">本人提供</option><option value="agent_supplied">Agent 提供</option><option value="rss">RSS 订阅</option><option value="web_search">网页搜索</option><option value="demo">演示材料</option></select></div></div>
              <button id="reset-filters" class="quiet">清除筛选</button>
            </details>
            <p id="queue-error" role="alert"></p><p id="selection-note" class="subtle" hidden>当前文章不在筛选结果中。</p>
          </div>
          <div id="candidate-list" class="candidate-list" aria-label="候选资料列表" aria-busy="true"></div><p id="queue-empty" class="empty-copy" hidden>没有匹配的文章。请调整筛选条件。</p>
        </details>
      </aside>
      <div class="candidate-detail">
        <section id="candidate-empty" class="candidate-empty"><div class="empty-icon" aria-hidden="true">↗</div><h2>选择一篇文章</h2><p>从列表打开资料，或添加原文链接。</p></section>
        <article id="screening" hidden>
          <header class="candidate-title">
            <div class="article-meta"><a id="source-link" target="_blank" rel="noopener noreferrer"></a><span id="article-date"></span></div>
            <h2 id="candidate-title" tabindex="-1"></h2><p id="stage-status" class="subtle" aria-live="polite"></p>
            <div class="candidate-actions"><a id="read" class="primary-link">阅读原文 ↗</a><a id="curate">写自己的笔记</a><button id="process" class="primary">保存原文</button></div>
          </header>
          <div class="review-tabs workspace-tabs" role="tablist" aria-label="审核内容"><button id="tab-overview" role="tab" aria-selected="true" aria-controls="view-overview" data-view="overview">阅读建议</button><button id="tab-evidence" role="tab" aria-selected="false" aria-controls="view-evidence" data-view="evidence" tabindex="-1">原文依据</button><button id="tab-trace" role="tab" aria-selected="false" aria-controls="view-trace" data-view="trace" tabindex="-1">运行记录</button></div>
          <section class="review-tab-panel" id="view-overview" role="tabpanel" aria-labelledby="tab-overview">
            <div class="optional-screen"><div><span class="section-label">中文阅读建议</span><span id="preview-scope" class="subtle"></span></div><button id="screen-button">生成阅读建议</button></div>
            <p id="pending-result" class="empty-copy">还没有生成阅读建议。你可以直接阅读原文，也可以按需运行一次价值判断。</p>
            <div id="result" hidden>
              <p id="recommendation" class="verdict"></p>
              <section class="reading-intro"><p id="value"></p><details><summary>判断理由</summary><p id="reason"></p></details></section>
              <section class="reading-section"><h3>适用条件</h3><ul id="conditions"></ul></section>
              <section class="reading-section"><h3>还需要核实</h3><ul id="unknowns"></ul></section>
              <details class="verification-details"><summary>证据与时效检查</summary><p id="date-result"></p><p id="check-result"></p></details>
            </div>
          </section>
          <section class="review-tab-panel" id="view-evidence" role="tabpanel" aria-labelledby="tab-evidence" hidden><p class="subtle">引文来自本次检查的原文片段。定位通过不代表解释准确。</p><div id="evidence"></div></section>
          <section class="review-tab-panel" id="view-trace" role="tabpanel" aria-labelledby="tab-trace" hidden>
            <div class="trace-toolbar"><span class="section-label">调用与检查</span><button id="refresh" class="quiet">刷新记录</button></div>
            <div class="log-summary"><div><span>历史运行</span><b id="trace-count">—</b></div><div><span>本次 tokens</span><b id="trace-tokens">—</b></div><div><span>本次耗时</span><b id="trace-duration">—</b></div></div>
            <p id="trace-execution" class="subtle"></p><p id="budget" class="subtle"></p>
            <details><summary>原文与采集状态</summary><p id="source-facts"></p><p id="current-date" class="subtle"></p><ol class="pipeline-strip" aria-label="候选处理流程"><li id="step-fetch">获取网页</li><li id="step-extract">提取正文</li></ol><a id="work" class="cactus-link">查看采集记录</a><pre id="processing-history"></pre></details>
            <details><summary>学习目标与本次输入</summary><dl class="input-facts" id="input-facts"></dl><details><summary>输入 JSON</summary><pre id="candidate-input"></pre></details></details>
            <h3 class="trace-heading">运行历史</h3><p class="subtle">旧结果和失败记录保留。模型输出尚未经过你的确认。</p><div id="attempts"></div><a id="json" class="cactus-link" target="_blank" rel="noopener">完整 JSON ↗</a>
          </section>
        </article>
      </div>
    </div>
  </section>
  <script>import '@/scripts/candidates';</script>
</Layout>
